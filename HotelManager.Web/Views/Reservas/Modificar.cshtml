@model ReservaFormViewModel
@{
    ViewBag.Title = "Modificar reserva";
    ViewData["Icono"] = "bi-pencil-square";
    ViewData["Color"] = "blue";
    ViewData["Modulo"] = "Reservas";
    ViewData["ModuloUrl"] = Url.Action("Detalle", new { id = Model.IdReserva });
    ViewData["Titulo"] = "Modificar reserva #" + Model.IdReserva;
    ViewData["Subtitulo"] = "CU-008: cambie fechas, habitación o cantidad de huéspedes; el costo se recalcula.";
}
@Html.Partial("_FormPage")
@Html.Partial("_Form", Model)
