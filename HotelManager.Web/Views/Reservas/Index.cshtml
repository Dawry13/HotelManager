@model List<ReservaItemViewModel>
@{
    ViewBag.Title = "Reservas";
    var conteos = (Dictionary<string, int>)ViewBag.Conteos;
    Func<string, int> c = e => conteos.ContainsKey(e) ? conteos[e] : 0;
    string estado = ViewBag.Estado;
    DateTime? desde = ViewBag.Desde;
    DateTime? hasta = ViewBag.Hasta;
    var tarjetas = new[]
    {
        new { Estado = "Pendiente", Css = "blue", Icono = "bi-hourglass-split" },
        new { Estado = "Confirmada", Css = "green", Icono = "bi-calendar2-check" },
        new { Estado = "Modificada", Css = "purple", Icono = "bi-pencil-square" },
        new { Estado = "Cancelada", Css = "pink", Icono = "bi-x-octagon" },
        new { Estado = "Finalizada", Css = "gold", Icono = "bi-door-open" }
    };
}
<div class="hm-page-head">
    <div class="hm-page-title">
        <div class="hm-page-icon green"><i class="bi bi-calendar-week"></i></div>
        <div>
            <div class="hm-breadcrumb"><a href="@Url.Action("Index", "Home")">Inicio</a> / Reservas</div>
            <h1>Reservas</h1>
            <p class="hm-sub">Consulta, creación, modificación y cancelación de reservas.</p>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-ghost" href="@Url.Action("Historial")"><i class="bi bi-clock-history me-1"></i> Historial</a>
        <a class="btn btn-gold" href="@Url.Action("Disponibilidad")"><i class="bi bi-calendar-plus me-1"></i> Nueva reserva</a>
    </div>
</div>

<div class="row g-3 mb-4">
    @foreach (var t in tarjetas)
    {
        <div class="col-6 col-md-4 col-xl">
            <a class="hm-stat @t.Css compact @(estado == t.Estado ? "hm-stat-activo" : "")" href="@Url.Action("Index", new { estado = estado == t.Estado ? null : t.Estado })">
                <div class="hm-stat-icon"><i class="bi @t.Icono"></i></div>
                <div><div class="hm-stat-value">@c(t.Estado)</div><div class="hm-stat-label">@(t.Estado)s</div></div>
            </a>
        </div>
    }
</div>

<form method="get" class="hm-card hm-filters mb-4">
    <input type="hidden" name="estado" value="@estado" />
    <div class="hm-field" style="flex-grow:2">
        <label for="buscar">Buscar</label>
        <input type="search" class="form-control" id="buscar" name="buscar" value="@ViewBag.Buscar" placeholder="Huésped, habitación o # de reserva" />
    </div>
    <div class="hm-field">
        <label for="idHotel">Hotel</label>
        @Html.DropDownList("idHotel", (SelectList)ViewBag.Hoteles, "Todos los hoteles", new { @class = "form-select" })
    </div>
    <div class="hm-field" style="flex-basis:150px">
        <label for="desde">Desde</label>
        <input type="date" class="form-control" id="desde" name="desde" value="@(desde.HasValue ? desde.Value.ToString("yyyy-MM-dd") : "")" />
    </div>
    <div class="hm-field" style="flex-basis:150px">
        <label for="hasta">Hasta</label>
        <input type="date" class="form-control" id="hasta" name="hasta" value="@(hasta.HasValue ? hasta.Value.ToString("yyyy-MM-dd") : "")" />
    </div>
    <button class="btn btn-ghost" type="submit"><i class="bi bi-funnel me-1"></i> Filtrar</button>
    <a class="btn btn-ghost" href="@Url.Action("Index")" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
</form>

<div class="hm-card">
    <div class="table-responsive">
        <table class="table hm-table table-hover">
            <thead>
                <tr>
                    <th>Reserva</th>
                    <th>Huésped</th>
                    <th>Habitación</th>
                    <th>Estadía</th>
                    <th class="text-center"><i class="bi bi-people"></i></th>
                    <th class="text-end">Costo</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="hm-empty"><i class="bi bi-calendar-x"></i>No hay reservas que coincidan con los filtros.</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td><span class="hm-code">#@r.Id</span></td>
                        <td>
                            <a class="d-flex align-items-center gap-2 text-reset text-decoration-none" href="@Url.Action("Detalle", "Huespedes", new { id = r.IdHuesped })">
                                <span class="hm-res-avatar m-0" style="width:36px;height:36px;font-size:.8rem">@ContextoHotel.Iniciales(r.Huesped)</span>
                                <span class="hm-cell-main">@r.Huesped</span>
                            </a>
                        </td>
                        <td>
                            <div class="hm-cell-main">Hab. @r.Habitacion <span class="hm-cell-sub">· @r.Tipo</span></div>
                            <div class="hm-cell-sub">@r.Hotel</div>
                        </td>
                        <td class="small">
                            <i class="bi bi-calendar3 me-1 text-secondary"></i>@r.Entrada.ToString("dd MMM", new System.Globalization.CultureInfo("es-DO")) – @r.Salida.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-DO"))
                            <div class="hm-cell-sub">@r.Noches noche(s)</div>
                        </td>
                        <td class="text-center">@r.Huespedes</td>
                        <td class="text-end fw-semibold">RD$ @r.Costo.ToString("N2")</td>
                        <td><span class="hm-badge @EstadoHelper.CssReserva(r.Estado)">@r.Estado</span></td>
                        <td class="text-end acciones">
                            <a class="btn-icon i-view" href="@Url.Action("Detalle", new { id = r.Id })" title="Ver detalle"><i class="bi bi-eye"></i></a>
                            @if (r.EsActiva)
                            {
                                <a class="btn-icon i-edit" href="@Url.Action("Modificar", new { id = r.Id })" title="Modificar"><i class="bi bi-pencil"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="small text-secondary mt-3"><i class="bi bi-info-circle me-1"></i>@Model.Count reserva(s) · Total RD$ @Model.Where(r => r.Estado != "Cancelada").Sum(r => r.Costo).ToString("N2") (sin canceladas)</p>
