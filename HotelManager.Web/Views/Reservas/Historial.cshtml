@model List<HistorialItemViewModel>
@{
    ViewBag.Title = "Historial de reservas";
    DateTime? desde = ViewBag.Desde;
    DateTime? hasta = ViewBag.Hasta;
    string accion = ViewBag.Accion;
    var culture = new System.Globalization.CultureInfo("es-DO");
    var acciones = new[] { "creacion", "modificacion", "cambio_estado", "cancelacion" };
}
<div class="hm-page-head">
    <div class="hm-page-title">
        <div class="hm-page-icon"><i class="bi bi-clock-history"></i></div>
        <div>
            <div class="hm-breadcrumb"><a href="@Url.Action("Index", "Home")">Inicio</a> / <a href="@Url.Action("Index")">Reservas</a> / Historial</div>
            <h1>Historial de reservas</h1>
            <p class="hm-sub">CU-010: auditoría de creaciones, cambios y cancelaciones (registrada por la base de datos).</p>
        </div>
    </div>
</div>

<form method="get" class="hm-card hm-filters mb-4">
    <div class="hm-field" style="flex-basis:170px">
        <label for="desde">Desde</label>
        <input type="date" class="form-control" id="desde" name="desde" value="@(desde.HasValue ? desde.Value.ToString("yyyy-MM-dd") : "")" />
    </div>
    <div class="hm-field" style="flex-basis:170px">
        <label for="hasta">Hasta</label>
        <input type="date" class="form-control" id="hasta" name="hasta" value="@(hasta.HasValue ? hasta.Value.ToString("yyyy-MM-dd") : "")" />
    </div>
    <div class="hm-field">
        <label for="accion">Acción</label>
        <select class="form-select" id="accion" name="accion">
            <option value="">Todas</option>
            @foreach (var a in acciones)
            {
                <option value="@a" @(accion == a ? "selected" : "")>@TextoHelper.Titulo(a.Replace("_", " "))</option>
            }
        </select>
    </div>
    <button class="btn btn-ghost" type="submit"><i class="bi bi-funnel me-1"></i> Filtrar</button>
</form>

<div class="hm-card">
    <div class="table-responsive">
        <table class="table hm-table table-hover">
            <thead><tr><th>Fecha</th><th>Reserva</th><th>Huésped</th><th>Habitación</th><th>Acción</th><th>Cambio de estado</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="hm-empty"><i class="bi bi-clock"></i>No hay movimientos en ese período.</td></tr>
                }
                @foreach (var h in Model)
                {
                    <tr>
                        <td class="small">@h.Fecha.ToString("dd/MM/yyyy", culture)<div class="hm-cell-sub">@h.Fecha.ToString("hh:mm tt", culture)</div></td>
                        <td><a class="hm-code text-decoration-none" href="@Url.Action("Detalle", new { id = h.IdReserva })">#@h.IdReserva</a></td>
                        <td class="hm-cell-main">@h.Huesped</td>
                        <td>Hab. @h.Habitacion<div class="hm-cell-sub">@h.Hotel</div></td>
                        <td class="text-capitalize">@h.Accion.Replace("_", " ")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(h.EstadoAnterior))
                            {
                                <span class="hm-badge @EstadoHelper.CssReserva(h.EstadoAnterior)">@h.EstadoAnterior</span> <i class="bi bi-arrow-right mx-1 text-secondary"></i>
                            }
                            <span class="hm-badge @EstadoHelper.CssReserva(h.EstadoNuevo)">@h.EstadoNuevo</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
