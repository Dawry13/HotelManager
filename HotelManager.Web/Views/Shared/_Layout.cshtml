@{
    var controlador = (string)ViewContext.RouteData.Values["controller"];
    var accion = (string)ViewContext.RouteData.Values["action"];
    Func<string, string> activo = c => string.Equals(c, controlador, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    int pendientes = ViewBag.NotificacionesPendientes ?? 0;

    // Menu segun el rol (RNF-001). Los nombres vienen de HotelManager.Business.Seguridad.Roles.
    var esAdmin = User.IsInRole("Administrador");
    var esRecepcion = User.IsInRole("Recepcionista");
    var esHuesped = User.IsInRole("Huesped");
    var esServicio = User.IsInRole("ServicioNotificacion");
    var gestion = esAdmin || esRecepcion;
    var verNotificaciones = gestion || esServicio;
    int solicitudesTotal = ViewBag.SolicitudesTotal ?? 0;
    var solicitudes = (List<HotelManager.Web.Infrastructure.SolicitudPendiente>)ViewBag.Solicitudes
                      ?? new List<HotelManager.Web.Infrastructure.SolicitudPendiente>();
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - HotelManager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/site.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/site.css")).Ticks" />
</head>
<body>
    <div class="hm-shell">
        <aside class="hm-sidebar" id="sidebar">
            <a class="hm-brand" href="@Url.Action("Index", "Home")">
                <svg viewBox="0 0 80 80" aria-hidden="true">
                    <defs>
                        <linearGradient id="gLogo" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" stop-color="#ffd34d" /><stop offset="1" stop-color="#e59400" />
                        </linearGradient>
                    </defs>
                    <path d="M40 4 l3 6 6.5 .8 -4.8 4.4 1.3 6.4 -6 -3.2 -6 3.2 1.3 -6.4 -4.8 -4.4 6.5 -.8z" fill="url(#gLogo)" />
                    <g fill="none" stroke="url(#gLogo)" stroke-width="3" stroke-linejoin="round">
                        <path d="M26 72 V30 h28 v42" />
                        <path d="M14 72 V44 h12" /><path d="M66 72 V44 H54" />
                        <path d="M8 73 h64" />
                    </g>
                    <g fill="url(#gLogo)">
                        <rect x="31" y="35" width="5" height="5" /><rect x="44" y="35" width="5" height="5" />
                        <rect x="31" y="45" width="5" height="5" /><rect x="44" y="45" width="5" height="5" />
                        <rect x="31" y="55" width="5" height="5" /><rect x="44" y="55" width="5" height="5" />
                        <rect x="18" y="50" width="4" height="4" /><rect x="18" y="59" width="4" height="4" />
                        <rect x="58" y="50" width="4" height="4" /><rect x="58" y="59" width="4" height="4" />
                        <path d="M36 72 v-7 a4 4 0 0 1 8 0 v7z" />
                    </g>
                </svg>
                <div class="hm-brand-name">Hotel<span>Manager</span></div>
                <div class="hm-brand-tag">Hospitalidad, en tus manos</div>
            </a>

            <ul class="hm-nav">
                @if (gestion)
                {
                    <li><a class="@activo("Home")" href="@Url.Action("Index", "Home")"><i class="bi bi-house-door-fill"></i> Inicio</a></li>
                    <li class="hm-nav-label">Operación</li>
                    <li><a class="@(controlador == "Reservas" && accion != "Disponibilidad" && accion != "Historial" ? "active" : "")" href="@Url.Action("Index", "Reservas")"><i class="bi bi-calendar-week"></i> Reservas</a></li>
                    <li><a class="@(controlador == "Reservas" && accion == "Disponibilidad" ? "active" : "")" href="@Url.Action("Disponibilidad", "Reservas")"><i class="bi bi-search-heart"></i> Disponibilidad</a></li>
                    <li><a class="@activo("Huespedes")" href="@Url.Action("Index", "Huespedes")"><i class="bi bi-people"></i> Huéspedes</a></li>
                    <li><a class="@activo("Hoteles")" href="@Url.Action("Index", "Hoteles")"><i class="bi bi-buildings"></i> Hoteles</a></li>
                }
                @if (esAdmin)
                {
                    <li class="hm-nav-label">Estructura hotelera</li>
                    <li><a class="@activo("Bloques")" href="@Url.Action("Index", "Bloques")"><i class="bi bi-grid-1x2"></i> Bloques</a></li>
                    <li><a class="@activo("Pisos")" href="@Url.Action("Index", "Pisos")"><i class="bi bi-layers"></i> Pisos</a></li>
                    <li><a class="@activo("Habitaciones")" href="@Url.Action("Index", "Habitaciones")"><i class="bi bi-door-closed"></i> Habitaciones</a></li>
                    <li class="hm-nav-label">Catálogos</li>
                    <li><a class="@activo("TiposHabitacion")" href="@Url.Action("Index", "TiposHabitacion")"><i class="bi bi-tags"></i> Tipos de habitación</a></li>
                    <li><a class="@activo("Tarifas")" href="@Url.Action("Index", "Tarifas")"><i class="bi bi-cash-coin"></i> Tarifas</a></li>
                }
                @if (esHuesped)
                {
                    <li class="hm-nav-label">Mi cuenta</li>
                    <li><a class="@(controlador == "Portal" && accion != "Solicitar" ? "active" : "")" href="@Url.Action("Index", "Portal")"><i class="bi bi-calendar-heart"></i> Mis reservas</a></li>
                    <li><a class="@(controlador == "Portal" && accion == "Solicitar" ? "active" : "")" href="@Url.Action("Solicitar", "Portal")"><i class="bi bi-calendar-plus"></i> Solicitar reserva</a></li>
                }
                @if (verNotificaciones)
                {
                    <li class="hm-nav-label">Seguimiento</li>
                    <li>
                        <a class="@activo("Notificaciones")" href="@Url.Action("Index", "Notificaciones")"><i class="bi bi-bell"></i> Notificaciones
                            @if (pendientes > 0)
                            {
                                <span class="hm-badge info ms-auto px-2 py-0">@pendientes</span>
                            }
                        </a>
                    </li>
                }
                @if (esAdmin)
                {
                    <li><a class="@(controlador == "Reservas" && accion == "Historial" ? "active" : "")" href="@Url.Action("Historial", "Reservas")"><i class="bi bi-clock-history"></i> Historial</a></li>
                    <li><a class="@activo("Reportes")" href="@Url.Action("Index", "Reportes")"><i class="bi bi-bar-chart-line"></i> Reportes</a></li>
                    <li class="hm-nav-label">Seguridad</li>
                    <li><a class="@activo("Usuarios")" href="@Url.Action("Index", "Usuarios")"><i class="bi bi-person-gear"></i> Usuarios y roles</a></li>
                }
                <li class="hm-nav-label">Sitio público</li>
                <li><a href="@Url.Action("Index", "Explorar")"><i class="bi bi-globe2"></i> Ver catálogo de huéspedes</a></li>
            </ul>

            <div class="hm-sidebar-quote">Grandes experiencias, comienzan con una buena reserva.</div>
        </aside>
        <div class="hm-backdrop" id="sidebarBackdrop"></div>

        <div class="hm-main">
            <header class="hm-topbar">
                <button class="hm-menu-btn" type="button" id="menuBtn" aria-label="Abrir menú"><i class="bi bi-list"></i></button>
                @if (gestion)
                {
                    <form class="hm-search" method="get" action="@Url.Action("Buscar", "Home")" role="search">
                        <i class="bi bi-search"></i>
                        <input type="search" name="q" value="@Request.QueryString["q"]" placeholder="Buscar reservas, huéspedes o habitaciones..." aria-label="Buscar" />
                    </form>
                }
                @if (gestion)
                {
                    @* Campana del personal: solicitudes de reserva de huespedes por aprobar *@
                    <div class="dropdown ms-auto" id="campanaSolicitudes"
                         data-url="@Url.Action("SolicitudesPendientes", "Reservas")"
                         data-ultimo="@(solicitudes.Any() ? solicitudes.Max(s => s.IdReserva) : 0)"
                         data-total="@solicitudesTotal">
                        <button class="hm-bell border-0" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                                aria-label="Solicitudes de reserva por aprobar" title="@solicitudesTotal solicitud(es) por aprobar">
                            <i class="bi bi-bell"></i>
                            <span class="hm-dot @(solicitudesTotal > 0 ? "" : "d-none")" id="campanaContador">@(solicitudesTotal > 99 ? "99+" : solicitudesTotal.ToString())</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end hm-campana p-0">
                            <div class="hm-campana-head">
                                <strong><i class="bi bi-bell me-1"></i> Solicitudes por aprobar</strong>
                                <span class="hm-badge @(solicitudesTotal > 0 ? "warn" : "off")">@solicitudesTotal</span>
                            </div>
                            @if (!solicitudes.Any())
                            {
                                <div class="hm-empty py-4"><i class="bi bi-check2-all"></i>No hay solicitudes pendientes.</div>
                            }
                            @foreach (var s in solicitudes)
                            {
                                <div class="hm-campana-item">
                                    <div class="d-flex justify-content-between gap-2">
                                        <div style="min-width:0">
                                            <div class="fw-semibold text-truncate">@s.Huesped</div>
                                            <div class="small text-secondary text-truncate">@s.Hotel · Hab. @s.Habitacion · @s.Personas persona(s)</div>
                                            <div class="small"><i class="bi bi-calendar3 me-1 text-secondary"></i>@s.Entrada.ToString("dd/MM") → @s.Salida.ToString("dd/MM/yyyy") · <span class="text-gold">RD$ @s.Costo.ToString("N0")</span></div>
                                        </div>
                                        <span class="hm-code align-self-start">#@s.IdReserva</span>
                                    </div>
                                    <div class="d-flex gap-2 mt-2">
                                        @using (Html.BeginForm("Confirmar", "Reservas", new { id = s.IdReserva }, FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@Request.RawUrl" />
                                            <button class="btn btn-gold btn-sm"><i class="bi bi-check2-circle me-1"></i>Aprobar</button>
                                        }
                                        <a class="btn btn-ghost btn-sm" href="@Url.Action("Detalle", "Reservas", new { id = s.IdReserva })">Ver detalle</a>
                                    </div>
                                </div>
                            }
                            <a class="hm-campana-foot" href="@Url.Action("Index", "Reservas", new { estado = "Pendiente" })">Ver todas las solicitudes <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                }
                else if (verNotificaciones)
                {
                    <a class="hm-bell" href="@Url.Action("Index", "Notificaciones", new { estado = "Pendiente" })" title="@pendientes notificación(es) pendiente(s)">
                        <i class="bi bi-bell"></i>
                        @if (pendientes > 0)
                        {
                            <span class="hm-dot">@(pendientes > 99 ? "99+" : pendientes.ToString())</span>
                        }
                    </a>
                }
                <div class="hm-user dropdown @(verNotificaciones ? "" : "ms-auto")">
                    <button class="hm-user-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="hm-avatar">@ViewBag.UsuarioIniciales</div>
                        <div class="hm-user-text text-start">
                            <div class="hm-user-name">@ViewBag.UsuarioNombre</div>
                            <div class="hm-user-role">@ViewBag.UsuarioRol</div>
                        </div>
                        <i class="bi bi-chevron-down small text-secondary"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end p-2">
                        <li><span class="dropdown-item-text small text-secondary"><i class="bi bi-person me-1"></i>@User.Identity.Name</span></li>
                        <li><a class="dropdown-item" href="@Url.Action("CambiarClave", "Cuenta")"><i class="bi bi-key me-2"></i>Cambiar contraseña</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            @using (Html.BeginForm("Salir", "Cuenta", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</button>
                            }
                        </li>
                    </ul>
                </div>
            </header>

            <main class="hm-content">
                @Html.Partial("_Alertas")
                @RenderBody()
            </main>

            <footer class="hm-footer">
                HotelManager &middot; Sistema de Gestión de Reservas de Hoteles &middot; @DateTime.Now.Year
            </footer>
        </div>
    </div>

    @if (gestion)
    {
        @* Aviso emergente cuando llega una solicitud nueva mientras se usa el sistema *@
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast hm-toast" id="avisoSolicitud" role="status" aria-live="polite" aria-atomic="true" data-bs-delay="10000">
                <div class="toast-header">
                    <i class="bi bi-bell-fill text-gold me-2"></i><strong class="me-auto">Nueva solicitud de reserva</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
                <div class="toast-body">
                    <span id="avisoSolicitudTexto">Un huésped solicitó una reserva.</span>
                    <div class="mt-2 d-flex gap-2">
                        <a class="btn btn-gold btn-sm" href="@Url.Action("Index", "Reservas", new { estado = "Pendiente" })">Revisar ahora</a>
                        <a class="btn btn-ghost btn-sm" href="@Request.RawUrl">Actualizar</a>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/site.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/site.js")).Ticks"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
