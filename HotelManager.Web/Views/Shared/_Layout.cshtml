@{
    var controlador = (string)ViewContext.RouteData.Values["controller"];
    var accion = (string)ViewContext.RouteData.Values["action"];
    Func<string, string> activo = c => string.Equals(c, controlador, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    int pendientes = ViewBag.NotificacionesPendientes ?? 0;
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - HotelManager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>
    <div class="hm-shell">
        <aside class="hm-sidebar" id="sidebar">
            <a class="hm-brand" href="@Url.Action("Index", "Home")">
                <svg viewBox="0 0 80 80" aria-hidden="true">
                    <defs>
                        <linearGradient id="gLogo" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" stop-color="#ffd34d" /><stop offset="1" stop-color="#e59400" />
                        </linearGradient>
                    </defs>
                    <path d="M40 4 l3 6 6.5 .8 -4.8 4.4 1.3 6.4 -6 -3.2 -6 3.2 1.3 -6.4 -4.8 -4.4 6.5 -.8z" fill="url(#gLogo)" />
                    <g fill="none" stroke="url(#gLogo)" stroke-width="3" stroke-linejoin="round">
                        <path d="M26 72 V30 h28 v42" />
                        <path d="M14 72 V44 h12" /><path d="M66 72 V44 H54" />
                        <path d="M8 73 h64" />
                    </g>
                    <g fill="url(#gLogo)">
                        <rect x="31" y="35" width="5" height="5" /><rect x="44" y="35" width="5" height="5" />
                        <rect x="31" y="45" width="5" height="5" /><rect x="44" y="45" width="5" height="5" />
                        <rect x="31" y="55" width="5" height="5" /><rect x="44" y="55" width="5" height="5" />
                        <rect x="18" y="50" width="4" height="4" /><rect x="18" y="59" width="4" height="4" />
                        <rect x="58" y="50" width="4" height="4" /><rect x="58" y="59" width="4" height="4" />
                        <path d="M36 72 v-7 a4 4 0 0 1 8 0 v7z" />
                    </g>
                </svg>
                <div class="hm-brand-name">Hotel<span>Manager</span></div>
                <div class="hm-brand-tag">Hospitalidad, en tus manos</div>
            </a>

            <ul class="hm-nav">
                <li><a class="@activo("Home")" href="@Url.Action("Index", "Home")"><i class="bi bi-house-door-fill"></i> Inicio</a></li>
                <li class="hm-nav-label">Operación</li>
                <li><a class="@(controlador == "Reservas" && accion != "Disponibilidad" && accion != "Historial" ? "active" : "")" href="@Url.Action("Index", "Reservas")"><i class="bi bi-calendar-week"></i> Reservas</a></li>
                <li><a class="@(controlador == "Reservas" && accion == "Disponibilidad" ? "active" : "")" href="@Url.Action("Disponibilidad", "Reservas")"><i class="bi bi-search-heart"></i> Disponibilidad</a></li>
                <li><a class="@activo("Huespedes")" href="@Url.Action("Index", "Huespedes")"><i class="bi bi-people"></i> Huéspedes</a></li>
                <li class="hm-nav-label">Estructura hotelera</li>
                <li><a class="@activo("Hoteles")" href="@Url.Action("Index", "Hoteles")"><i class="bi bi-buildings"></i> Hoteles</a></li>
                <li><a class="@activo("Bloques")" href="@Url.Action("Index", "Bloques")"><i class="bi bi-grid-1x2"></i> Bloques</a></li>
                <li><a class="@activo("Pisos")" href="@Url.Action("Index", "Pisos")"><i class="bi bi-layers"></i> Pisos</a></li>
                <li><a class="@activo("Habitaciones")" href="@Url.Action("Index", "Habitaciones")"><i class="bi bi-door-closed"></i> Habitaciones</a></li>
                <li class="hm-nav-label">Catálogos</li>
                <li><a class="@activo("TiposHabitacion")" href="@Url.Action("Index", "TiposHabitacion")"><i class="bi bi-tags"></i> Tipos de habitación</a></li>
                <li><a class="@activo("Tarifas")" href="@Url.Action("Index", "Tarifas")"><i class="bi bi-cash-coin"></i> Tarifas</a></li>
                <li class="hm-nav-label">Seguimiento</li>
                <li>
                    <a class="@activo("Notificaciones")" href="@Url.Action("Index", "Notificaciones")"><i class="bi bi-bell"></i> Notificaciones
                        @if (pendientes > 0)
                        {
                            <span class="hm-badge info ms-auto px-2 py-0">@pendientes</span>
                        }
                    </a>
                </li>
                <li><a class="@(controlador == "Reservas" && accion == "Historial" ? "active" : "")" href="@Url.Action("Historial", "Reservas")"><i class="bi bi-clock-history"></i> Historial</a></li>
                <li><a class="@activo("Reportes")" href="@Url.Action("Index", "Reportes")"><i class="bi bi-bar-chart-line"></i> Reportes</a></li>
            </ul>

            <div class="hm-sidebar-quote">Grandes experiencias, comienzan con una buena reserva.</div>
        </aside>
        <div class="hm-backdrop" id="sidebarBackdrop"></div>

        <div class="hm-main">
            <header class="hm-topbar">
                <button class="hm-menu-btn" type="button" id="menuBtn" aria-label="Abrir menú"><i class="bi bi-list"></i></button>
                <form class="hm-search" method="get" action="@Url.Action("Buscar", "Home")" role="search">
                    <i class="bi bi-search"></i>
                    <input type="search" name="q" value="@Request.QueryString["q"]" placeholder="Buscar reservas, huéspedes o habitaciones..." aria-label="Buscar" />
                </form>
                <a class="hm-bell" href="@Url.Action("Index", "Notificaciones", new { estado = "Pendiente" })" title="@pendientes notificación(es) pendiente(s)">
                    <i class="bi bi-bell"></i>
                    @if (pendientes > 0)
                    {
                        <span class="hm-dot">@(pendientes > 99 ? "99+" : pendientes.ToString())</span>
                    }
                </a>
                <div class="hm-user">
                    <div class="hm-avatar">@ViewBag.UsuarioIniciales</div>
                    <div class="hm-user-text">
                        <div class="hm-user-name">@ViewBag.UsuarioNombre</div>
                        <div class="hm-user-role">@ViewBag.UsuarioRol</div>
                    </div>
                </div>
            </header>

            <main class="hm-content">
                @Html.Partial("_Alertas")
                @RenderBody()
            </main>

            <footer class="hm-footer">
                HotelManager &middot; Sistema de Gestión de Reservas de Hoteles &middot; @DateTime.Now.Year
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/site.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
