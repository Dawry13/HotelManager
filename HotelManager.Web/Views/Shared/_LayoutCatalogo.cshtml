@{
    // Layout publico: invitados (sin registro) y huespedes.
    var controlador = (string)ViewContext.RouteData.Values["controller"];
    var accion = (string)ViewContext.RouteData.Values["action"];
    var autenticado = User.Identity.IsAuthenticated;
    var esHuesped = User.IsInRole("Huesped");
    var esPersonal = User.IsInRole("Administrador") || User.IsInRole("Recepcionista");
    var categoriaActual = Request.QueryString["categoria"];
    Func<bool, string> activo = b => b ? "active" : "";
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - HotelManager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/site.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/site.css")).Ticks" />
</head>
<body class="hm-body-catalogo">
    <nav class="hm-topnav navbar navbar-expand-lg">
        <div class="container-xl">
            <a class="hm-topnav-brand" href="@Url.Action("Index", "Explorar")">
                <i class="bi bi-buildings-fill"></i> Hotel<span>Manager</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPublico" aria-controls="menuPublico" aria-expanded="false" aria-label="Abrir menú">
                <i class="bi bi-list fs-3"></i>
            </button>
            <div class="collapse navbar-collapse" id="menuPublico">
                <ul class="navbar-nav me-auto ms-lg-4 gap-lg-1">
                    <li class="nav-item"><a class="nav-link @activo(controlador == "Explorar" && string.IsNullOrEmpty(categoriaActual))" href="@Url.Action("Index", "Explorar")"><i class="bi bi-compass me-1"></i>Hoteles</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @activo(!string.IsNullOrEmpty(categoriaActual))" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-star me-1"></i>Categorías</a>
                        <ul class="dropdown-menu">
                            @for (var c = 5; c >= 3; c--)
                            {
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Explorar", new { categoria = c })">@CatalogoHelper.Estrellas(c) <span class="ms-2">@CatalogoHelper.NombreCategoria(c)</span></a></li>
                            }
                        </ul>
                    </li>
                    @if (esHuesped)
                    {
                        <li class="nav-item"><a class="nav-link @activo(controlador == "Portal" && accion != "Solicitar")" href="@Url.Action("Index", "Portal")"><i class="bi bi-calendar-heart me-1"></i>Mis reservas</a></li>
                    }
                    @if (esPersonal)
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")"><i class="bi bi-speedometer2 me-1"></i>Panel de gestión</a></li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2 py-2 py-lg-0">
                    @if (!autenticado)
                    {
                        <a class="btn btn-ghost btn-sm" href="@Url.Action("Login", "Cuenta")"><i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión</a>
                        <a class="btn btn-gold btn-sm" href="@Url.Action("Registro", "Cuenta", new { returnUrl = Request.RawUrl })"><i class="bi bi-person-plus me-1"></i>Crear cuenta</a>
                    }
                    else
                    {
                        <div class="dropdown">
                            <button class="hm-user-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="hm-avatar">@ViewBag.UsuarioIniciales</div>
                                <div class="hm-user-text text-start d-none d-sm-block">
                                    <div class="hm-user-name">@ViewBag.UsuarioNombre</div>
                                    <div class="hm-user-role">@ViewBag.UsuarioRol</div>
                                </div>
                                <i class="bi bi-chevron-down small text-secondary"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end p-2">
                                <li><span class="dropdown-item-text small text-secondary"><i class="bi bi-person me-1"></i>@User.Identity.Name</span></li>
                                @if (esHuesped)
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Index", "Portal")"><i class="bi bi-calendar-heart me-2"></i>Mis reservas</a></li>
                                }
                                <li><a class="dropdown-item" href="@Url.Action("CambiarClave", "Cuenta")"><i class="bi bi-key me-2"></i>Cambiar contraseña</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    @using (Html.BeginForm("Salir", "Cuenta", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</button>
                                    }
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container-xl hm-catalogo-main">
        @Html.Partial("_Alertas")
        @RenderBody()
    </main>

    <footer class="hm-footer hm-catalogo-footer">
        <div class="container-xl d-flex flex-wrap justify-content-between gap-2">
            <span>HotelManager &middot; Reservas de hoteles &middot; @DateTime.Now.Year</span>
            <span>
                <a class="hm-link" href="@Url.Action("Index", "Explorar")">Hoteles</a>
                @if (!autenticado)
                {
                    <span class="mx-2">·</span><a class="hm-link" href="@Url.Action("Login", "Cuenta")">Acceso del personal</a>
                }
            </span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/site.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/site.js")).Ticks"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
