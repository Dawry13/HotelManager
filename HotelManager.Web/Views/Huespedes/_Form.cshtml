@model HuespedViewModel
@{
    var esEdicion = Model.IdHuesped > 0;
}
<div class="row g-4">
    <div class="col-lg-8">
        <div class="hm-card hm-card-body">
            @using (Html.BeginForm(esEdicion ? "Editar" : "Crear", "Huespedes", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdHuesped)
                @Html.HiddenFor(m => m.ReturnUrl)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="hm-form-section">Identificación</div>
                <div class="row">
                    <div class="col-md-7 mb-3">
                        @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", maxlength = "150", autofocus = "autofocus", placeholder = "Ej.: María González" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "small" })
                    </div>
                    <div class="col-md-5 mb-3">
                        @Html.LabelFor(m => m.Documento, new { @class = "form-label" })
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-vcard"></i></span>
                            @Html.TextBoxFor(m => m.Documento, new { @class = "form-control", maxlength = "30", placeholder = "001-0000000-1" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Documento, "", new { @class = "small" })
                    </div>
                </div>

                <div class="hm-form-section mt-3">Contacto</div>
                <div class="row">
                    <div class="col-md-7 mb-3">
                        @Html.LabelFor(m => m.Correo, new { @class = "form-label" })
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", type = "email", maxlength = "150", placeholder = "correo@ejemplo.com" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "small" })
                    </div>
                    <div class="col-md-5 mb-4">
                        @Html.LabelFor(m => m.Telefono, new { @class = "form-label" })
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", maxlength = "20", placeholder = "809-555-0000" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "small" })
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-gold"><i class="bi bi-save me-1"></i> @(esEdicion ? "Guardar cambios" : "Registrar huésped")</button>
                    <a class="btn btn-ghost" href="@(string.IsNullOrEmpty(Model.ReturnUrl) ? Url.Action("Index") : Model.ReturnUrl)">Cancelar</a>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="hm-card hm-card-body">
            <div class="hm-form-section">Reglas</div>
            <div class="hm-rule"><i class="bi bi-person-vcard"></i><div><strong>RF-005</strong>La reserva requiere identificar al huésped.</div></div>
            <div class="hm-rule"><i class="bi bi-fingerprint"></i><div><strong>Documento único</strong>No se registran dos huéspedes con el mismo documento.</div></div>
            <div class="hm-rule"><i class="bi bi-envelope-check"></i><div><strong>Correo obligatorio</strong>Se usa para las notificaciones de confirmación, modificación y cancelación.</div></div>
        </div>
    </div>
</div>
