@model RegistroHuespedViewModel
@{
    ViewBag.Title = "Crear cuenta de huésped";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}
<div class="hm-card hm-card-body p-4">
    <h1 class="h3 fw-bold mb-1">Crear cuenta de huésped</h1>
    <p class="text-secondary mb-4">Con su cuenta podrá solicitar reservas y ver sus confirmaciones.</p>

    @using (Html.BeginForm("Registro", "Cuenta", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="hm-form-section">Sus datos</div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", maxlength = "150", autofocus = "autofocus" })
            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "small" })
        </div>
        <div class="row">
            <div class="col-sm-6 mb-3">
                @Html.LabelFor(m => m.Documento, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Documento, new { @class = "form-control", maxlength = "30" })
                @Html.ValidationMessageFor(m => m.Documento, "", new { @class = "small" })
            </div>
            <div class="col-sm-6 mb-3">
                @Html.LabelFor(m => m.Telefono, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", maxlength = "20" })
                @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "small" })
            </div>
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Correo, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", type = "email", maxlength = "150" })
            <div class="form-text">Aquí recibirá la confirmación de sus reservas.</div>
            @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "small" })
        </div>

        <div class="hm-form-section mt-4">Acceso</div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Usuario, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Usuario, new { @class = "form-control", maxlength = "50", autocomplete = "username", autocapitalize = "none" })
            @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "small" })
        </div>
        <div class="row">
            <div class="col-sm-6 mb-3">
                @Html.LabelFor(m => m.Clave, new { @class = "form-label" })
                @Html.PasswordFor(m => m.Clave, new { @class = "form-control", autocomplete = "new-password" })
                @Html.ValidationMessageFor(m => m.Clave, "", new { @class = "small" })
            </div>
            <div class="col-sm-6 mb-3">
                @Html.LabelFor(m => m.ConfirmarClave, new { @class = "form-label" })
                @Html.PasswordFor(m => m.ConfirmarClave, new { @class = "form-control", autocomplete = "new-password" })
                @Html.ValidationMessageFor(m => m.ConfirmarClave, "", new { @class = "small" })
            </div>
        </div>
        <div class="form-text mb-4">Mínimo 8 caracteres, con letras y números.</div>

        <button type="submit" class="btn btn-gold w-100 py-2"><i class="bi bi-person-plus me-1"></i> Crear cuenta</button>
    }
    <p class="text-center mt-3 mb-0 small text-secondary">¿Ya tiene cuenta? <a class="hm-link" href="@Url.Action("Login")">Inicie sesión</a></p>
</div>
