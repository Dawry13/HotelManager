@model CambiarClaveViewModel
@{
    ViewBag.Title = "Cambiar contraseña";
    Layout = Model.Obligatorio ? "~/Views/Shared/_LayoutPublico.cshtml" : "~/Views/Shared/_Layout.cshtml";
}
<div class="hm-card hm-card-body p-4" style="max-width:520px">
    <h1 class="h3 fw-bold mb-1"><i class="bi bi-key me-2 text-gold"></i>Cambiar contraseña</h1>
    @if (Model.Obligatorio)
    {
        <div class="alert alert-info mt-3">Está usando una contraseña temporal. Elija una nueva para continuar.</div>
    }
    else
    {
        <p class="text-secondary mb-4">Actualice la contraseña de su cuenta.</p>
    }

    @using (Html.BeginForm("CambiarClave", "Cuenta", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
        <div class="mb-3">
            @Html.LabelFor(m => m.ClaveActual, new { @class = "form-label" })
            @Html.PasswordFor(m => m.ClaveActual, new { @class = "form-control", autocomplete = "current-password", autofocus = "autofocus" })
            @Html.ValidationMessageFor(m => m.ClaveActual, "", new { @class = "small" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.ClaveNueva, new { @class = "form-label" })
            @Html.PasswordFor(m => m.ClaveNueva, new { @class = "form-control", autocomplete = "new-password" })
            <div class="form-text">Mínimo 8 caracteres, con letras y números.</div>
            @Html.ValidationMessageFor(m => m.ClaveNueva, "", new { @class = "small" })
        </div>
        <div class="mb-4">
            @Html.LabelFor(m => m.ConfirmarClave, new { @class = "form-label" })
            @Html.PasswordFor(m => m.ConfirmarClave, new { @class = "form-control", autocomplete = "new-password" })
            @Html.ValidationMessageFor(m => m.ConfirmarClave, "", new { @class = "small" })
        </div>
        <button type="submit" class="btn btn-gold w-100 py-2"><i class="bi bi-save me-1"></i> Guardar contraseña</button>
    }
    @using (Html.BeginForm("Salir", "Cuenta", FormMethod.Post, new { @class = "text-center mt-3" }))
    {
        @Html.AntiForgeryToken()
        <button class="btn btn-link hm-link">Cerrar sesión</button>
    }
</div>
