@{
    ViewBag.Title = "Acceso denegado";
    var autenticado = User.Identity.IsAuthenticated;
    var gestion = User.IsInRole("Administrador") || User.IsInRole("Recepcionista") || User.IsInRole("ServicioNotificacion");
    Layout = gestion ? "~/Views/Shared/_Layout.cshtml" : "~/Views/Shared/_LayoutCatalogo.cshtml";
}
<div class="hm-card hm-card-body text-center py-5 mx-auto" style="max-width:560px">
    <div class="hm-page-icon pink mx-auto mb-3"><i class="bi bi-shield-lock"></i></div>
    <h1 class="h3">Acceso denegado</h1>
    <p class="text-secondary">Su cuenta no tiene permiso para esta sección. Cada rol solo accede a las opciones que le corresponden.</p>
    <a class="btn btn-gold" href="@Url.Action("Index", "Home")">Volver al inicio</a>
    @if (!autenticado)
    {
        <a class="btn btn-ghost ms-2" href="@Url.Action("Login", "Cuenta")">Iniciar sesión</a>
    }
</div>
