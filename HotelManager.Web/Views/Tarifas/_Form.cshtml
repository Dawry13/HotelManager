@model TarifaViewModel
@{
    var esEdicion = Model.IdTarifa > 0;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<div class="row g-4">
    <div class="col-lg-8">
        <div class="hm-card hm-card-body">
            @using (Html.BeginForm(esEdicion ? "Editar" : "Crear", "Tarifas", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdTarifa)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="hm-form-section">Habitación</div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.IdHabitacion, new { @class = "form-label" })
                    @if (esEdicion)
                    {
                        @Html.HiddenFor(m => m.IdHabitacion)
                        <input class="form-control" value="Hab. @Model.Habitacion · @Model.Hotel" readonly />
                    }
                    else
                    {
                        @Html.DropDownListFor(m => m.IdHabitacion, (List<SelectListItem>)ViewBag.Habitaciones, "-- Seleccione la habitación --", new { @class = "form-select" })
                    }
                    @Html.ValidationMessageFor(m => m.IdHabitacion, "", new { @class = "small" })
                </div>

                <div class="hm-form-section mt-4">Temporada</div>
                <div class="row">
                    <div class="col-sm-4 mb-3">
                        @Html.LabelFor(m => m.ValorNoche, new { @class = "form-label" })
                        <div class="input-group">
                            <span class="input-group-text">RD$</span>
                            <input class="form-control" id="ValorNoche" name="ValorNoche" type="number" min="0.01" step="0.01"
                                   value="@(Model.ValorNoche.HasValue ? Model.ValorNoche.Value.ToString("0.00", inv) : "")" />
                        </div>
                        @Html.ValidationMessageFor(m => m.ValorNoche, "", new { @class = "small" })
                    </div>
                    <div class="col-sm-4 mb-3">
                        @Html.LabelFor(m => m.VigenciaDesde, new { @class = "form-label" })
                        <input class="form-control" type="date" id="VigenciaDesde" name="VigenciaDesde" value="@(Model.VigenciaDesde.HasValue ? Model.VigenciaDesde.Value.ToString("yyyy-MM-dd") : "")" />
                        @Html.ValidationMessageFor(m => m.VigenciaDesde, "", new { @class = "small" })
                    </div>
                    <div class="col-sm-4 mb-4">
                        @Html.LabelFor(m => m.VigenciaHasta, new { @class = "form-label" })
                        <input class="form-control" type="date" id="VigenciaHasta" name="VigenciaHasta" value="@(Model.VigenciaHasta.HasValue ? Model.VigenciaHasta.Value.ToString("yyyy-MM-dd") : "")" />
                        <div class="form-text">Vacío = sin fecha de fin.</div>
                        @Html.ValidationMessageFor(m => m.VigenciaHasta, "", new { @class = "small" })
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-gold"><i class="bi bi-save me-1"></i> @(esEdicion ? "Guardar cambios" : "Registrar tarifa")</button>
                    <a class="btn btn-ghost" href="@Url.Action("Index", new { idHabitacion = Model.IdHabitacion })">Cancelar</a>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="hm-card hm-card-body">
            <div class="hm-form-section">Cómo se aplica</div>
            <div class="hm-rule"><i class="bi bi-cash-coin"></i><div><strong>RN-013</strong>Cada noche se cobra con la tarifa vigente ese día; si no hay, con la tarifa base.</div></div>
            <div class="hm-rule"><i class="bi bi-intersect"></i><div><strong>Sin cruces</strong>Dos tarifas de la misma habitación no pueden tener vigencias superpuestas.</div></div>
            @if (Model.TarifaBase > 0)
            {
                <div class="hm-rule"><i class="bi bi-info-circle"></i><div><strong>Tarifa base actual</strong>RD$ @Model.TarifaBase.ToString("N2") por noche.</div></div>
            }
        </div>
    </div>
</div>
