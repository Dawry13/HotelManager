@model List<PisoViewModel>
@{
    ViewBag.Title = "Pisos";
}
<div class="hm-page-head">
    <div class="hm-page-title">
        <div class="hm-page-icon green"><i class="bi bi-layers"></i></div>
        <div>
            <div class="hm-breadcrumb"><a href="@Url.Action("Index", "Home")">Inicio</a> / Pisos</div>
            <h1>Gestión de pisos</h1>
            <p class="hm-sub">Niveles de cada hotel y bloque donde se ubican las habitaciones.</p>
        </div>
    </div>
    <a class="btn btn-gold" href="@Url.Action("Crear", new { idHotel = ViewBag.IdHotel, idBloque = ViewBag.IdBloque })"><i class="bi bi-plus-lg me-1"></i> Nuevo piso</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="hm-stat green compact"><div class="hm-stat-icon"><i class="bi bi-layers"></i></div>
            <div><div class="hm-stat-value">@Model.Count</div><div class="hm-stat-label">Pisos</div></div></div>
    </div>
    <div class="col-sm-4">
        <div class="hm-stat purple compact"><div class="hm-stat-icon"><i class="bi bi-check2-circle"></i></div>
            <div><div class="hm-stat-value">@Model.Count(p => p.Estado == "Activo")</div><div class="hm-stat-label">Activos</div></div></div>
    </div>
    <div class="col-sm-4">
        <div class="hm-stat blue compact"><div class="hm-stat-icon"><i class="bi bi-door-closed"></i></div>
            <div><div class="hm-stat-value">@Model.Sum(p => p.TotalHabitaciones)</div><div class="hm-stat-label">Habitaciones</div></div></div>
    </div>
</div>

<form method="get" class="hm-card hm-filters mb-4">
    <div class="hm-field">
        <label for="idHotel">Hotel</label>
        @Html.DropDownList("idHotel", (SelectList)ViewBag.Hoteles, "Todos los hoteles", new { @class = "form-select", data_autosubmit = "" })
    </div>
    <div class="hm-field">
        <label for="idBloque">Bloque</label>
        @Html.DropDownList("idBloque", (SelectList)ViewBag.Bloques, "Todos los bloques", new { @class = "form-select", data_autosubmit = "" })
    </div>
</form>

<div class="hm-card">
    <div class="table-responsive">
        <table class="table hm-table table-hover">
            <thead>
                <tr>
                    <th>Piso</th>
                    <th>Hotel</th>
                    <th>Bloque</th>
                    <th class="text-center">Habitaciones</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="hm-empty"><i class="bi bi-layers"></i>No hay pisos registrados.</td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td><div class="d-flex align-items-center gap-3"><span class="hm-code">@p.Numero</span><span class="hm-cell-main">Piso @p.Numero</span></div></td>
                        <td class="text-capitalize">@p.NombreHotel</td>
                        <td class="text-capitalize">@p.NombreBloque</td>
                        <td class="text-center"><a class="hm-link" href="@Url.Action("Index", "Habitaciones", new { idHotel = p.IdHotel })">@p.TotalHabitaciones</a></td>
                        <td><span class="hm-badge @EstadoHelper.CssActivo(p.Estado)">@p.Estado</span></td>
                        <td class="text-end acciones">
                            <a class="btn-icon i-edit" href="@Url.Action("Editar", new { id = p.IdPiso })" title="Editar"><i class="bi bi-pencil"></i></a>
                            @if (p.Estado == "Activo")
                            {
                                <a class="btn-icon i-view" href="@Url.Action("Crear", "Habitaciones", new { idHotel = p.IdHotel, idPiso = p.IdPiso })" title="Agregar habitación"><i class="bi bi-door-open"></i></a>
                            }
                            @using (Html.BeginForm("CambiarEstado", "Pisos", new { id = p.IdPiso, idHotel = ViewBag.IdHotel }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                if (p.Estado == "Activo")
                                {
                                    <button class="btn-icon i-on" title="Desactivar"
                                            onclick="return confirm('Un piso inactivo no puede recibir nuevas habitaciones. ¿Desactivar?');"><i class="bi bi-toggle-on"></i></button>
                                }
                                else
                                {
                                    <button class="btn-icon i-off" title="Activar"><i class="bi bi-toggle-off"></i></button>
                                }
                            }
                            @using (Html.BeginForm("Eliminar", "Pisos", new { id = p.IdPiso, idHotel = ViewBag.IdHotel }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button class="btn-icon i-del" title="Eliminar"
                                        onclick="return confirm('¿Eliminar el piso @p.Numero? Esta acción no se puede deshacer.');"><i class="bi bi-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
