<?xml version="1.0" encoding="utf-8"?>
<!--
  PLANTILLA para enviar correos reales.
  1. Copie este archivo en la misma carpeta con el nombre  Correo.config
  2. Complete Remitente, Usuario y Clave.
  3. Ejecute la aplicacion: cada reserva enviara el correo de confirmacion al huesped.

  Correo.config esta en .gitignore: su contrasena NO se sube al repositorio.

  GMAIL: la cuenta debe tener verificacion en 2 pasos y usar una "Contrasena de aplicacion"
         (Cuenta de Google > Seguridad > Contrasenas de aplicaciones). No use su contrasena normal.
  OUTLOOK / HOTMAIL: Servidor smtp-mail.outlook.com, Puerto 587, Ssl true.
-->
<appSettings>
  <add key="Correo:Modo" value="Smtp" />
  <add key="Correo:Servidor" value="smtp.gmail.com" />
  <add key="Correo:Puerto" value="587" />
  <add key="Correo:Ssl" value="true" />
  <add key="Correo:Remitente" value="su.cuenta@gmail.com" />
  <add key="Correo:NombreRemitente" value="HotelManager Reservas" />
  <add key="Correo:Usuario" value="su.cuenta@gmail.com" />
  <add key="Correo:Clave" value="contrasena-de-aplicacion-de-16-letras" />
</appSettings>
