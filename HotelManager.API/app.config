<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="HotelManagerDB"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=HotelManagerDB;Integrated Security=True;Connect Timeout=60"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings file="Correo.config">
		<add key="Correo:Modo" value="Smtp" />
		<add key="Correo:Servidor" value="smtp.gmail.com" />
		<add key="Correo:Puerto" value="587" />
		<add key="Correo:Ssl" value="true" />
		<add key="Correo:NombreRemitente" value="HotelManager Reservas" />
	</appSettings>
</configuration>